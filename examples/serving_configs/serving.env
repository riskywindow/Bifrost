# Generated BIFROST Phase 6 serving environment.
# Source this file only for opt-in local experiments. It contains no private
# tokens and intentionally does not set HF_TOKEN or HUGGING_FACE_HUB_TOKEN.

BIFROST_PHASE6_MODE=lmcache_inprocess
BIFROST_ENDPOINT="127.0.0.1:7744"
BIFROST_VLLM_MODEL="./local-model"
BIFROST_VLLM_PORT=8000
BIFROST_LMCACHE_PORT=9000
BIFROST_LMCACHE_CHUNK_SIZE=262144
BIFROST_ALLOW_PICKLE_FALLBACK=0
BIFROST_GPU_MEMORY_UTILIZATION=
BIFROST_MAX_MODEL_LEN=
LMCACHE_CONFIG_FILE="bifrost_lmcache_inprocess.yaml"
