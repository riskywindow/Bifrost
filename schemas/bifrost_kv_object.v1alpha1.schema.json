{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bifrost.local/schemas/bifrost_kv_object.v1alpha1.schema.json",
  "title": "BIFROST KV Object v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_id",
    "created_at_unix_ms",
    "created_by",
    "model_profile",
    "engine_profile",
    "prefix_profile",
    "payload_profile",
    "native_tensor_profile",
    "opaque_engine_profile",
    "integrity",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "bifrost.kv_object.v1alpha1" },
    "object_type": { "enum": ["native_kv_page", "opaque_engine_blob"] },
    "object_id": { "$ref": "#/$defs/object_id" },
    "created_at_unix_ms": { "$ref": "#/$defs/non_negative_integer" },
    "created_by": { "$ref": "#/$defs/non_empty_string" },
    "model_profile": { "$ref": "#/$defs/model_profile" },
    "engine_profile": { "$ref": "#/$defs/engine_profile" },
    "prefix_profile": {
      "anyOf": [
        { "$ref": "#/$defs/prefix_profile" },
        { "type": "null" }
      ]
    },
    "payload_profile": { "$ref": "#/$defs/payload_profile" },
    "native_tensor_profile": {
      "anyOf": [
        { "$ref": "#/$defs/native_tensor_profile" },
        { "type": "null" }
      ]
    },
    "opaque_engine_profile": {
      "anyOf": [
        { "$ref": "#/$defs/opaque_engine_profile" },
        { "type": "null" }
      ]
    },
    "integrity": { "$ref": "#/$defs/integrity" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^bifrost://object/blake3/[0-9a-f]{64}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/non_negative_integer" },
        "end": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "hash_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" }
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision",
        "model_hash",
        "tokenizer_hash",
        "config_hash",
        "rope_config_hash",
        "quantization",
        "dtype",
        "num_layers",
        "num_attention_heads",
        "num_kv_heads",
        "head_dim",
        "max_position_embeddings"
      ],
      "properties": {
        "model_id": { "$ref": "#/$defs/non_empty_string" },
        "model_revision": { "$ref": "#/$defs/non_empty_string" },
        "model_hash": { "$ref": "#/$defs/hash" },
        "tokenizer_hash": { "$ref": "#/$defs/hash" },
        "config_hash": { "$ref": "#/$defs/hash" },
        "rope_config_hash": { "$ref": "#/$defs/hash" },
        "quantization": { "$ref": "#/$defs/non_empty_string" },
        "dtype": { "$ref": "#/$defs/non_empty_string" },
        "num_layers": { "$ref": "#/$defs/positive_integer" },
        "num_attention_heads": { "$ref": "#/$defs/positive_integer" },
        "num_kv_heads": { "$ref": "#/$defs/positive_integer" },
        "head_dim": { "$ref": "#/$defs/positive_integer" },
        "max_position_embeddings": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "engine_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_name",
        "engine_version",
        "integration_name",
        "integration_version",
        "attention_impl",
        "kv_layout",
        "block_size_tokens",
        "kv_cache_format"
      ],
      "properties": {
        "engine_name": { "$ref": "#/$defs/non_empty_string" },
        "engine_version": { "$ref": "#/$defs/non_empty_string" },
        "integration_name": { "$ref": "#/$defs/non_empty_string" },
        "integration_version": { "$ref": "#/$defs/non_empty_string" },
        "attention_impl": { "$ref": "#/$defs/non_empty_string" },
        "kv_layout": { "$ref": "#/$defs/non_empty_string" },
        "block_size_tokens": { "$ref": "#/$defs/positive_integer" },
        "kv_cache_format": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "prefix_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_count",
        "token_range",
        "absolute_position_range",
        "prefix_hash",
        "token_hash",
        "tokenizer_hash",
        "rope_config_hash",
        "mm_hashes"
      ],
      "properties": {
        "token_count": { "$ref": "#/$defs/non_negative_integer" },
        "token_range": { "$ref": "#/$defs/range" },
        "absolute_position_range": { "$ref": "#/$defs/range" },
        "prefix_hash": { "$ref": "#/$defs/hash" },
        "token_hash": { "$ref": "#/$defs/hash" },
        "tokenizer_hash": { "$ref": "#/$defs/hash" },
        "rope_config_hash": { "$ref": "#/$defs/hash" },
        "mm_hashes": { "$ref": "#/$defs/hash_array" }
      }
    },
    "payload_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "compression", "payload_encoding"],
      "properties": {
        "byte_length": { "$ref": "#/$defs/non_negative_integer" },
        "compression": { "$ref": "#/$defs/non_empty_string" },
        "payload_encoding": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "native_tensor_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "kv_block_id",
        "block_size_tokens",
        "block_token_count",
        "token_range",
        "tensor_role",
        "tensor_shape",
        "tensor_dtype",
        "tensor_layout"
      ],
      "properties": {
        "layer_id": { "$ref": "#/$defs/non_negative_integer" },
        "kv_block_id": { "$ref": "#/$defs/non_negative_integer" },
        "block_size_tokens": { "$ref": "#/$defs/positive_integer" },
        "block_token_count": { "$ref": "#/$defs/non_negative_integer" },
        "token_range": { "$ref": "#/$defs/range" },
        "tensor_role": { "enum": ["key", "value", "kv", "kv_pair"] },
        "tensor_shape": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/positive_integer" }
        },
        "tensor_dtype": { "$ref": "#/$defs/non_empty_string" },
        "tensor_layout": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "opaque_engine_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_key_hash",
        "engine_payload_type",
        "engine_key_repr_version"
      ],
      "properties": {
        "engine_key_hash": { "$ref": "#/$defs/hash" },
        "engine_payload_type": { "$ref": "#/$defs/non_empty_string" },
        "engine_key_repr_version": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_hash",
        "payload_hash",
        "object_id_algorithm",
        "chunk_size_bytes",
        "chunk_hashes"
      ],
      "properties": {
        "descriptor_hash": { "$ref": "#/$defs/hash" },
        "payload_hash": { "$ref": "#/$defs/hash" },
        "object_id_algorithm": { "const": "bifrost.object_id.v1" },
        "chunk_size_bytes": { "$ref": "#/$defs/positive_integer" },
        "chunk_hashes": { "$ref": "#/$defs/hash_array" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "notes",
        "producer_commit",
        "producer_hostname"
      ],
      "properties": {
        "source": { "$ref": "#/$defs/non_empty_string" },
        "notes": { "type": "string" },
        "producer_commit": { "$ref": "#/$defs/non_empty_string" },
        "producer_hostname": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
